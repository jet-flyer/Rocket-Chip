# RocketChip git attributes
# Council CR-7: Ensure consistent line endings for reference CSVs
# to prevent spurious diffs on Windows.
test/data/reference/*.csv text eol=lf

# Cygwin bash scripts (CRLF breaks `cd "$(dirname "$0")"` and `set -eu`)
tools/spin/*.sh text eol=lf
# Starcom shell scripts (CRLF makes `exit 0\r` fail with exit 2)
starcom/scripts/*.sh text eol=lf

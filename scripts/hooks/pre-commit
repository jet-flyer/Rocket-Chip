#!/bin/bash
# RocketChip pre-commit hook (tracked — set: git config core.hooksPath scripts/hooks)
#
# 1) <stdio.h> no-new-include gate (per docs/decisions/STDIO_REPLACEMENT_PLAN.md)
# 2) clang-tidy size/complexity on staged flight-classified C++ (see below)
# 3) Host ctest when build_host/ exists
# 4) Flight target cross-compile (both roles) when a firmware path is staged
#    (scripts/ci/firmware_paths.txt [elf], via scripts/ci/pre_commit_matrix.py).
#    Keeps every commit buildable for git bisect.
#
# The bench (bench_sim / station_bench_sim) does NOT run here. It runs ONCE
# PER PUSH in scripts/hooks/pre-push on the commit being pushed
# (standards/HW_GATE_DISCIPLINE.md Rule 5).
#
# If a gate fails, Git makes no commit. Fix the cause, stage again, and run
# the same commit again. Do not use --no-verify.

CLANG_TIDY="C:/Program Files/LLVM/bin/clang-tidy.exe"
REPO_ROOT="$(git rev-parse --show-toplevel)"
BUILD_DIR="${REPO_ROOT}/build"

# ============================================================================
# Gate 1: <stdio.h> banned in src/*.cpp
# ============================================================================
# Allowlist mechanism retired 2026-05-17 per R-5 Unit J closure. No
# src/*.cpp may include <stdio.h>. Use rc::rc_log / rc::rc_snprintf /
# rc::strbuf instead (include/rocketchip/rc_log.h).

STAGED_CPP=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^src/.*\.cpp$')

if [[ -n "${STAGED_CPP}" ]]; then
    STDIO_VIOLATIONS=""
    for src in ${STAGED_CPP}; do
        if git diff --cached -- "${src}" 2>/dev/null \
                | grep -q '^\+.*#include.*<stdio\.h>'; then
            STDIO_VIOLATIONS="${STDIO_VIOLATIONS}${src}\n"
        elif git show ":${src}" 2>/dev/null | grep -q '^[[:space:]]*#include[[:space:]]*<stdio\.h>'; then
            STDIO_VIOLATIONS="${STDIO_VIOLATIONS}${src}\n"
        fi
    done

    if [[ -n "${STDIO_VIOLATIONS}" ]]; then
        echo ""
        echo "=== Pre-commit: <stdio.h> banned in src/*.cpp ==="
        echo ""
        printf "  %b" "${STDIO_VIOLATIONS}"
        echo ""
        echo "Use rc::rc_log / rc::rc_snprintf / rc::strbuf (rocketchip/rc_log.h)."
        echo "Fix the cause, stage again, and run the same commit again. Do not use --no-verify."
        exit 1
    fi
fi

# ============================================================================
# Gate 2: clang-tidy gated checks + warning-flag coverage
# ============================================================================
# Single source of truth: scripts/audit/full_tree_clang_tidy.sh (function size,
# cognitive complexity, unchecked return [flash_safe_execute], reserved-id, and
# the compiler-flag-coverage check). The SAME script runs full-tree at milestone
# close (SESSION_CHECKLIST item 17) — the check list lives in ONE place, no
# longer hard-coded here AND there (LL 40 dual-hardcode defect, fixed 2026-06-24).
#
# Needs clang-tidy + build/compile_commands.json from a target configure
# (cmake -B build -G Ninja). If either is absent, Gate 2 is SKIPPED but Gates
# 3 + 4 below MUST still run (2026-05-20 fail-open lesson — LL Entry 36 / 40).

if [[ -x "${CLANG_TIDY}" ]] && [[ -f "${BUILD_DIR}/compile_commands.json" ]]; then
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/.*\.cpp$')
    if [[ -n "${STAGED_FILES}" ]]; then
        if ! bash "${REPO_ROOT}/scripts/audit/full_tree_clang_tidy.sh" ${STAGED_FILES}; then
            echo ""
            echo "Commit blocked: fix the flagged functions / returns / coverage before committing."
            echo "Fix the cause, stage again, and run the same commit again. Do not use --no-verify."
            exit 1
        fi
    fi
fi

HOST_BUILD="${REPO_ROOT}/build_host"
if [[ -d "${HOST_BUILD}" ]] && [[ -f "${HOST_BUILD}/CTestTestfile.cmake" ]]; then
    echo "pre-commit: running host tests..."
    cmake --build "${HOST_BUILD}"
    (cd "${HOST_BUILD}" && ctest --output-on-failure)
    CTEST_RC=$?
    if [[ ${CTEST_RC} -ne 0 ]]; then
        echo ""
        echo "PRE-COMMIT BLOCKED: host tests failed"
        exit 1
    fi
    echo "pre-commit: host tests OK"
fi

# ============================================================================
# Gate 4: flight target cross-compile (both roles) + list completeness
# ============================================================================
# Policy 2026-05-16 (council unanimous, R-25-exec precedent, LL 36 + 39):
# "categories not enumerations." Any staged path in
# scripts/ci/firmware_paths.txt [elf] can produce a different image, so
# both role images must still build. Bench = pre-push (Rule 5), not here.
# The build uses the WORKING TREE (same as Gate 3). If the tree holds
# changes this commit does not include, commit from a clean worktree
# (docs/agents/SESSION_CHECKLIST.md item 4b).
TRIGGER_TARGET_BUILD=0
eval "$(python "${REPO_ROOT}/scripts/ci/pre_commit_matrix.py")"

if [[ "${TRIGGER_TARGET_BUILD}" == "1" ]]; then
    for pair in "build_flight:vehicle-flight" "build_station_flight:station-flight"; do
        dir="${pair%%:*}"
        preset="${pair##*:}"
        if [[ ! -f "${REPO_ROOT}/${dir}/CMakeCache.txt" ]]; then
            echo ""
            echo "PRE-COMMIT BLOCKED: firmware path staged but ${dir}/ is not configured"
            echo "  Configure once:  cmake --preset ${preset} -G Ninja"
            echo "  Then run the same commit again. Do not use --no-verify."
            exit 1
        fi
        echo "pre-commit: flight target cross-compile (${preset})..."
        if ! cmake --build "${REPO_ROOT}/${dir}"; then
            echo ""
            echo "PRE-COMMIT BLOCKED: ${preset} cross-compile failed"
            echo "Fix the cause, stage again, and run the same commit again. Do not use --no-verify."
            exit 1
        fi
    done
    echo "pre-commit: flight target cross-compile OK (both roles)"
    # List completeness: every repo file the two builds used must be in
    # [elf] of scripts/ci/firmware_paths.txt. Else the build ID and the
    # bench key miss it, and an old PASS could match new code.
    if ! python "${REPO_ROOT}/scripts/ci/check_elf_paths.py" "${REPO_ROOT}/build_flight" "${REPO_ROOT}/build_station_flight"; then
        echo ""
        echo "PRE-COMMIT BLOCKED: a file the flight build used is not in [elf]"
        echo "Add the path to [elf] in scripts/ci/firmware_paths.txt, stage it,"
        echo "and run the same commit again. Do not use --no-verify."
        exit 1
    fi
fi

exit 0

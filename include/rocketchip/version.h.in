// GENERATED. Do not edit this file. Template: include/rocketchip/version.h.in
// Product numbers come from repo-root RC_VERSION; git identity from the build.
// See standards/VERSIONING.md.
#ifndef ROCKETCHIP_VERSION_H
#define ROCKETCHIP_VERSION_H

#include <stdint.h>

#define RC_VERSION_MAJOR @RC_VERSION_MAJOR@
#define RC_VERSION_MINOR @RC_VERSION_MINOR@
#define RC_VERSION_PATCH @RC_VERSION_PATCH@
#define RC_VERSION_TWEAK @RC_VERSION_TWEAK@
#define RC_BUILD_NUMBER  @RC_BUILD_NUMBER@

#define RC_VERSION_STR_X(a, b, c) #a "." #b "." #c
#define RC_VERSION_STR(a, b, c) RC_VERSION_STR_X(a, b, c)

constexpr uint8_t     kVersionMajor = RC_VERSION_MAJOR;
constexpr uint8_t     kVersionMinor = RC_VERSION_MINOR;
constexpr uint8_t     kVersionPatch = RC_VERSION_PATCH;
constexpr uint32_t    kBuildNumber  = RC_BUILD_NUMBER;

// PCM log field: short X.Y.Z only (fits firmware_version[8], 7 chars + NUL).
constexpr const char* kFirmwareVersion =
    RC_VERSION_STR(RC_VERSION_MAJOR, RC_VERSION_MINOR, RC_VERSION_PATCH);
static_assert(sizeof("@RC_FIRMWARE_VERSION@") <= 8,
              "kFirmwareVersion must fit FlightLogHeader::firmware_version[8]");

// Human product string: MAJOR.MINOR.PATCH[-EXTRA]
constexpr const char* kVersionString = "@RC_VERSION_STRING@";

// Role/tier identity -- CMake, not a version number. Always "flight"
// post-R-26 (single flight binary per role).
constexpr const char* kBuildConfig = "@RC_BUILD_CONFIG@";

constexpr const char* kGitHash        = "@RC_GIT_HASH@";
constexpr const char* kBuildIdentity  = "@RC_BUILD_IDENTITY@";

#endif // ROCKETCHIP_VERSION_H
